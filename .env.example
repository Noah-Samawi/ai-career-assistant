# --- Pflicht ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/careerassistant
APP_URL=http://localhost:3000
# openssl rand -base64 32
FILE_ENCRYPTION_KEY=
STORAGE_DIR=./storage
NEXT_PUBLIC_APP_NAME=Noavio Career

# --- KI (einer reicht; ohne Key: CV-Heuristik, keine Anschreiben) ---
AI_PROVIDER=openai            # openai | anthropic | none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Optionale Job-Quellen ---
ADZUNA_APP_ID=                # https://developer.adzuna.com (kostenlos)
ADZUNA_APP_KEY=
SERPAPI_KEY=                  # https://serpapi.com (Google Jobs, kostenpflichtig)

# --- Cron-Endpunkt (/api/cron/run-loops) absichern ---
CRON_SECRET=
